# Copia esto a .env.local y rellena.
# .env.local NO va a git.

# ── Base de datos ───────────────────────────────────────────────────────────
# Sin estas dos, la aplicación usa un archivo local .datos/limpiezas.db.
# Las pone el Marketplace de Vercel al instalar Turso.
#
# EN LOCAL SE DEJAN VACÍAS a propósito: los scripts de scripts/ leen este
# archivo y van a donde diga la primera, así que con Turso configurado un
# `npm run esquema` se ejecuta contra la base del cliente y
# `npm run sembrar -- --rehacer` la reescribiría entera.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Autenticación ───────────────────────────────────────────────────────────
# Las tres las genera `npm run clave`, que además imprime la contraseña una vez
# y sólo una: de CLAVE_HASH no se saca de vuelta.
#
# Sin ellas: en local se pasa sin autenticar (con aviso en pantalla); en
# producción la aplicación se niega a servirse.
#
# SIN COMILLAS al pegarlas en Vercel. Un `.env` guarda el valor entrecomillado y
# el panel se las queda tal cual dentro del valor: el hash deja de ser el hash y
# no entra nadie, tampoco tú. Ya pasó una vez y el síntoma fue un 500 pelado.

# El nombre de usuario. Tiene forma de correo, pero no se le manda ningún
# correo nunca: no hay verificación, ni recuperación, ni avisos.
USUARIO=

# La contraseña pasada por scrypt. Formato: scrypt$N$r$p$sal$hash
CLAVE_HASH=

# Con qué se firman las cookies de sesión. Cambiarlo cierra en el acto todas las
# sesiones abiertas: es el botón de emergencia.
SESION_SECRETO=
