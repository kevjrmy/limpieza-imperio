# Copia esto a .env.local y rellena.
# .env.local NO va a git.

# ── Base de datos ───────────────────────────────────────────────────────────
# Sin estas dos, la aplicación usa un archivo local .datos/limpiezas.db.
# Las pone el Marketplace de Vercel al instalar Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Autenticación ───────────────────────────────────────────────────────────
# Las pone el Marketplace de Vercel al instalar Clerk.
# Sin ellas: en local se pasa sin autenticar (con aviso en pantalla);
# en producción la aplicación se niega a servirse.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar

# Correos con acceso, separados por comas. Vacío = entra cualquier cuenta de
# Clerk, que con el registro abierto es cualquiera.
#
# SIN COMILLAS al copiarlo a Vercel. Un `.env` guarda el valor entrecomillado y
# el panel de Vercel se queda las comillas tal cual: el primer correo hereda la
# de apertura, el último la de cierre, ninguno coincide y no entra nadie. El
# código ya las quita —ver `correosAutorizados` en `lib/sesion.js`—, pero no
# cuentes con eso: pégalo limpio.
CORREOS_AUTORIZADOS=
